# Copy to .env and adjust if needed.
DATABASE_URL=postgres://sovereign:sovereign@localhost:5432/sovereign
PORT=3000
NODE_ENV=production

# Credits are stored as whole minor units (1 credit = 100 minor units).
# New players start with this many credits.
STARTING_CAPITAL_CREDITS=10000

# Test runs: registering needs an access code (npm run invite).
# Set to "open" to let anyone register.
SIGNUP_MODE=open
